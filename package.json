{
  "name": "driverhub",
  "version": "1.0.0",
  "description": "All-in-one Android Driver Installer, Live Device Monitor, and Platform-Tools Manager for Windows",
  "author": "Aniket Sharma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketlab/DriverHub.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5173 && electron .\"",
    "build:vite": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:vite && npm run build:electron",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.driverhub.app",
    "productName": "Driver Hub",
    "publish": [
      {
        "provider": "github",
        "owner": "aniketlab",
        "repo": "DriverHub"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "asarUnpack": [
      "electron/bin/**/*",
      "electron/services/detectDevices.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Driver Hub",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "oxlint": "^1.81.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.0",
    "wait-on": "^7.2.0"
  }
}
